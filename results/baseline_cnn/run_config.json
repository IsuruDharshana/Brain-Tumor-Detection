{
  "seed": 42,
  "image_size": [
    224,
    224
  ],
  "channels": 3,
  "normalization": "divide_by_255_float32_0_to_1",
  "augmentation": {
    "applied_to": "training split only",
    "rotation_degrees": 8,
    "zoom_factor": 0.08,
    "translation_factor": 0.05,
    "contrast_factor": 0.1,
    "flips": false
  },
  "optimizer": "Adam",
  "loss": "SparseCategoricalCrossentropy",
  "batch_size": 32,
  "max_epochs": 30,
  "initial_learning_rate": 0.001,
  "callbacks": {
    "ModelCheckpoint": {
      "monitor": "val_loss",
      "save_best_only": true,
      "filepath": "/home/user/projects/Brain-Tumor-Detection/models/baseline_cnn.keras"
    },
    "EarlyStopping": {
      "monitor": "val_loss",
      "patience": 5,
      "restore_best_weights": true
    },
    "ReduceLROnPlateau": {
      "monitor": "val_loss",
      "factor": 0.5,
      "patience": 2,
      "min_lr": 1e-06
    }
  },
  "architecture": {
    "name": "baseline_cnn",
    "blocks": [
      {
        "conv_filters": 32,
        "bn": true,
        "pool": "MaxPool2D"
      },
      {
        "conv_filters": 64,
        "bn": true,
        "pool": "MaxPool2D"
      },
      {
        "conv_filters": 128,
        "bn": true,
        "pool": "MaxPool2D"
      },
      {
        "conv_filters": 256,
        "bn": true,
        "pool": null
      }
    ],
    "head": "GlobalAveragePooling2D \u2192 Dense(128, relu) \u2192 Dropout(0.4) \u2192 Dense(4, softmax)",
    "pretrained_weights": null
  },
  "train_manifest": "/home/user/projects/Brain-Tumor-Detection/data/processed/train_manifest.csv",
  "val_manifest": "/home/user/projects/Brain-Tumor-Detection/data/processed/val_manifest.csv"
}