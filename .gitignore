# Jupyter / IPython
# ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ──────────────────────────────────────────────
# Caches
# ──────────────────────────────────────────────
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
htmlcov/
.coverage
.coverage.*
coverage.xml

# ──────────────────────────────────────────────
# Datasets  (keep folder structure, ignore data)
# ──────────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5

# ──────────────────────────────────────────────
# Trained model files
# ──────────────────────────────────────────────
models/*
!models/.gitkeep
*.keras
*.pb
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.weights

# ──────────────────────────────────────────────
# Results / outputs  (keep folder, ignore files)
# ──────────────────────────────────────────────
results/*
!results/.gitkeep

# ──────────────────────────────────────────────
# Temporary files
# ──────────────────────────────────────────────
*.tmp
*.temp
*.log
*.bak
*.orig
tmp/
temp/

# ──────────────────────────────────────────────
# Secrets / environment variables
# ──────────────────────────────────────────────
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json
config/local*.yaml

# ──────────────────────────────────────────────
# OS artefacts
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
