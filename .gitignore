# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ──────────────────────────────────────────────
# Virtual Environments
# ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
virtualenv/

# ──────────────────────────────────────────────
# IDE / Editor
# ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.code-workspace

# ──────────────────────────────────────────────
# Jupyter / IPython
# ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ──────────────────────────────────────────────
# Caches
# ──────────────────────────────────────────────
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
htmlcov/
.coverage
.coverage.*
coverage.xml

# ──────────────────────────────────────────────
# Datasets  (keep folder structure, ignore data)
# ──────────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5

# ──────────────────────────────────────────────
# Trained model files
# ──────────────────────────────────────────────
models/*
!models/.gitkeep
*.keras
*.pb
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.weights

# ──────────────────────────────────────────────
# Results / outputs  (keep folder, ignore files)
# ──────────────────────────────────────────────
results/*
!results/.gitkeep

# Phase 2 dataset-audit summaries: whitelist only the small, reproducible
# artefacts (the large per-file image_metadata.csv stays ignored and can be
# regenerated with:  python -m src.data.audit_dataset )
!results/dataset_audit/
!results/dataset_audit/class_distribution.csv
!results/dataset_audit/corrupt_images.csv
!results/dataset_audit/exact_duplicates.csv
!results/dataset_audit/cross_split_duplicates.csv
!results/dataset_audit/perceptual_duplicates.csv
!results/dataset_audit/dataset_summary.json
!results/dataset_audit/audit_report.md
!results/dataset_audit/class_distribution.png
!results/dataset_audit/image_dimension_distribution.png

# Phase 3 preprocessing artefacts: whitelist only the small, deterministic
# outputs. The manifests are portable CSV metadata (relative paths only);
# resized images are never written to disk - preprocessing happens on the
# fly in the tf.data pipeline. Regenerate with:
#   python -m src.data.create_splits
!data/processed/train_manifest.csv
!data/processed/val_manifest.csv
!data/processed/test_manifest.csv
!results/preprocessing/
!results/preprocessing/training_deduplication.csv
!results/preprocessing/test_duplicates.csv
!results/preprocessing/split_summary.json
!results/preprocessing/class_distribution.csv
!results/preprocessing/preprocessing_samples.png

# Phase 4 baseline CNN artefacts: whitelist small reproducible outputs.
# The trained model checkpoint (models/baseline_cnn.keras) is NOT committed
# because models/* is intentionally ignored (large binary files).
# Regenerate training results with:  python -m src.models.train_baseline
!results/baseline_cnn/
!results/baseline_cnn/model_summary.txt
!results/baseline_cnn/training_history.csv
!results/baseline_cnn/training_curves.png
!results/baseline_cnn/training_summary.json
!results/baseline_cnn/run_config.json

# Phase 5 EfficientNetB0 artefacts: whitelist small reproducible outputs.
# Model checkpoints (models/*.keras) are NOT committed — large binary files.
# Regenerate with:  python -m src.models.train_efficientnet
!results/efficientnet_b0/
!results/efficientnet_b0/model_summary.txt
!results/efficientnet_b0/frozen_history.csv
!results/efficientnet_b0/finetune_history.csv
!results/efficientnet_b0/training_curves.png
!results/efficientnet_b0/training_summary.json
!results/efficientnet_b0/run_config.json
!results/efficientnet_b0/stage_comparison.json

# ──────────────────────────────────────────────
# Temporary files
# ──────────────────────────────────────────────
*.tmp
*.temp
*.log
*.bak
*.orig
tmp/
temp/

# ──────────────────────────────────────────────
# Secrets / environment variables
# ──────────────────────────────────────────────
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json
config/local*.yaml

# ──────────────────────────────────────────────
# OS artefacts
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
