# ──────────────────────────────────────────────
# Datasets  (keep folder structure, ignore data)
# ──────────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5

# ──────────────────────────────────────────────
